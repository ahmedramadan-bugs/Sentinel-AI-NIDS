# High-sensitivity real-time detection rules for live demo & evaluation
alert icmp any any -> any any (msg:"NIDS ICMP Echo Reconnaissance"; itype:8; threshold:type both, track by_src, count 1, seconds 10; classtype:attempted-recon; sid:9000001; rev:3;)
alert tcp any any -> any any (msg:"NIDS TCP SYN Port Scan"; flags:S; flow:stateless; detection_filter:track by_src, count 3, seconds 30; classtype:attempted-recon; sid:9000002; rev:3;)
alert tcp any any -> any 22 (msg:"NIDS SSH Connection Burst"; flags:S; flow:stateless; detection_filter:track by_src, count 2, seconds 30; classtype:attempted-admin; sid:9000003; rev:3;)
alert http any any -> any any (msg:"NIDS HTTP SQL Injection Attempt"; flow:to_server,established; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; within:32; classtype:web-application-attack; sid:9000004; rev:3;)
alert http any any -> any any (msg:"NIDS HTTP XSS Attempt"; flow:to_server,established; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:9000005; rev:3;)
alert http any any -> any any (msg:"NIDS HTTP Local File Inclusion Attempt"; flow:to_server,established; http.uri; content:"../"; classtype:web-application-attack; sid:9000006; rev:3;)
alert tcp any any -> any any (msg:"NIDS TCP SYN Flood / DoS"; flags:S; flow:stateless; detection_filter:track by_dst, count 25, seconds 5; classtype:attempted-dos; sid:9000007; rev:3;)
