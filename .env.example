# Copy this file to .env only if your process manager loads environment files.
# The application itself reads NIDS_* environment variables; no secrets belong here.
NIDS_EVE_LOG=runtime/eve.json
NIDS_DATABASE=runtime/nids.db
NIDS_DASHBOARD_HOST=127.0.0.1
NIDS_DASHBOARD_PORT=8080
NIDS_ML_CONFIDENCE_THRESHOLD=0.70
NIDS_RESPONSE_DRY_RUN=true
NIDS_TEMP_BLOCK_SECONDS=300
# Optional isolated location for response_engine history/whitelist/log files.
NIDS_RESPONSE_DATA_DIR=runtime/response-engine

# Set these only for an approved, isolated network lab.  Device credentials
# are read by the response engine from NIDS_CISCO_* environment variables.
# NIDS_RESPONSE_DRY_RUN=false
# NIDS_CISCO_HOST=192.0.2.10
# NIDS_CISCO_USERNAME=...
# NIDS_CISCO_PASSWORD=...
# NIDS_CISCO_SECRET=...
